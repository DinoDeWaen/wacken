diff --git a/test-bun/container-declaration.test.ts b/test-bun/container-declaration.test.ts
new file mode 100644
index 00000000..173f4d46
--- /dev/null
+++ b/test-bun/container-declaration.test.ts
@@ -0,0 +1,21 @@
+import { expect, test } from 'bun:test'
+import { cp, mkdtemp, rm } from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+import { writes } from '../src/authoring.ts'
+import { loadAnnotatedArchitecture } from '../src/core.ts'
+
+test.concurrent('explicit declaration accepts an unscannable container but cannot waive component evidence', async () => {
+  const root = await mkdtemp(path.join(os.tmpdir(), 'groma-declare-'))
+  try {
+    await cp(path.resolve(import.meta.dir, '../test/fixtures/edit'), root, { recursive: true })
+    const container = await writes.draft(root, { kind: 'container', name: 'Database', parent: 'shop', overview: 'Stores orders.', technology: 'SQL' })
+    const component = await writes.draft(root, { kind: 'component', name: 'Future', parent: 'api', overview: 'Not implemented.' })
+    await expect(writes.accept(root, { id: container })).rejects.toThrow('no scan match')
+    await writes.accept(root, { id: container, declared: true })
+    const accepted = (await loadAnnotatedArchitecture(root)).elements.find(item => item.id === container)!
+    expect(accepted).toMatchObject({ origin: 'observed', parent: 'shop', overview: 'Stores orders.', technology: 'SQL', code: [] })
+    await expect(writes.accept(root, { id: component, declared: true })).rejects.toThrow()
+    expect((await loadAnnotatedArchitecture(root)).elements.find(item => item.id === component)?.origin).toBe('draft')
+  } finally { await rm(root, { recursive: true, force: true }) }
+})
